+    /**
+     * Like {@link #findParameterUsage(ComponentInfo)}, but also includes references passed to a
+     * constructor, e.g. {@code new FormLayout(firstName, lastName)}. A rename must update those too, or
+     * the class no longer compiles.
+     */
+    private static List<Expression> findArgumentUsage(ComponentInfo componentDefinition) {
+        var createInfo = componentDefinition.getCreateInfoOrThrow();
+        List<Expression> refs;
+        if (createInfo.getFieldName() != null) {
+            refs = findUsageInClass(createInfo.getObjectCreationExpr(),
+                    body -> findNameReferences(createInfo.getFieldName(), body));
+        } else if (createInfo.getLocalVariableName() != null) {
+            refs = findNameReferences(createInfo.getLocalVariableName(), createInfo.getComponentCreateScope())
+                    .toList();
+        } else {
+            return findParameterUsage(componentDefinition);
+        }
+        return refs.stream().filter(ref -> isMethodCallArgument(ref) || isConstructorArgument(ref)).toList();
+    }
+
+    private static boolean isConstructorArgument(Expression ref) {
+        return ref.getParentNode().filter(parent -> parent instanceof ObjectCreationExpr creation
+                && creation.getArguments().contains(ref)).isPresent();
+    }
